<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Minhas medidas · Sugestões de Presentes</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
  :root{
    --bg:#F9F7F3; --paper:#FFFFFF; --ink:#4A3B5C; --muted:#8A7F98; --line:#ECE6F2;
    --pink:#FF6AA5; --pink-d:#E0508A; --lilac:#C4B1F4; --sky:#A9DDF5; --peach:#FFA98F; --mint:#AEE3C8;
    box-sizing:border-box;
    padding-top:env(safe-area-inset-top,0px);
    padding-bottom:env(safe-area-inset-bottom,0px);
  }
  *,*::before,*::after{box-sizing:inherit}
  html{scroll-padding-top:env(safe-area-inset-top,0px)}
  body{
    margin:0; background:var(--bg); color:var(--ink);
    font-family:"Nunito",system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:16px; line-height:1.55;
  }
  .wrap{max-width:560px; margin:0 auto; padding:28px 20px 64px}
  header{text-align:center; margin-bottom:26px}
  .logo{width:min(240px,70%);height:auto;display:block;margin:0 auto 14px}
  h1{
    font-family:"Fredoka","Nunito",sans-serif;font-weight:600;
    font-size:clamp(32px,8.5vw,42px);line-height:1.1;margin:0 0 10px;color:var(--pink-d);
  }
  header p{margin:0 auto;max-width:40ch;color:var(--muted)}
  form{background:var(--paper);border-radius:24px;padding:6px 22px 26px;
    border:2px solid var(--line)}
  fieldset{border:0;margin:0;padding:22px 0;border-bottom:2px dashed var(--line);--c:var(--lilac)}
  fieldset:nth-of-type(1){--c:var(--lilac)}
  fieldset:nth-of-type(2){--c:var(--sky)}
  fieldset:nth-of-type(3){--c:var(--peach)}
  fieldset:nth-of-type(4){--c:#FFB8D3}
  fieldset:nth-of-type(5){--c:var(--mint)}
  fieldset:nth-of-type(6){--c:var(--sky)}
  fieldset:nth-of-type(7){--c:var(--lilac)}
  fieldset:last-of-type{border-bottom:0}
  legend{
    font-family:"Fredoka","Nunito",sans-serif;font-weight:500;font-size:22px;color:var(--ink);
    padding:0;margin-bottom:4px;display:flex;align-items:center;gap:10px;
  }
  legend::before{content:"";width:14px;height:14px;border-radius:50%;background:var(--c);flex:none}
  .hint{font-size:14px;color:var(--muted);margin:0 0 14px}
  label.field{display:block;font-weight:700;font-size:15px;margin:14px 0 6px}
  input[type=text],select,textarea{
    width:100%;font:inherit;color:var(--ink);background:#FDFCFA;
    border:2px solid var(--line);border-radius:14px;padding:11px 14px;
  }
  textarea{min-height:88px;resize:vertical}
  input:focus-visible,select:focus-visible,textarea:focus-visible{
    outline:none;border-color:var(--c)
  }
  .chips{display:flex;flex-wrap:wrap;gap:8px}
  .chip{position:relative}
  .chip input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
  .chip span{
    display:inline-block;padding:8px 16px;border:2px solid var(--line);border-radius:999px;
    font-size:15px;font-weight:600;background:#FDFCFA;transition:background .15s,border-color .15s;
    user-select:none;
  }
  .chip input:checked + span{background:var(--c);border-color:var(--c);color:var(--ink)}
  .chip input:focus-visible + span{outline:2px solid var(--ink);outline-offset:2px}
  .row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .actions{margin-top:24px;display:grid;gap:10px}
  button{
    font-family:"Fredoka","Nunito",sans-serif;font-weight:500;font-size:19px;border:0;border-radius:999px;
    padding:15px;cursor:pointer;
  }
  .btn-main{background:var(--pink);color:#fff;box-shadow:0 4px 0 var(--pink-d)}
  .btn-main:active{transform:translateY(3px);box-shadow:0 1px 0 var(--pink-d)}
  .btn-share{background:#1FA855;color:#fff;display:none;box-shadow:0 4px 0 #168443}
  button:focus-visible{outline:3px solid var(--lilac);outline-offset:3px}
  .msg{text-align:center;font-size:14px;color:var(--muted);min-height:1.5em;margin:4px 0 0}
  .msg.error{color:#C2185B}
  .rainbow{display:flex;justify-content:center;gap:6px;margin:28px 0 8px}
  .rainbow i{width:8px;height:8px;border-radius:50%}
  footer{text-align:center;font-size:13px;color:var(--muted)}
  @media (max-width:380px){.row{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <img class="logo" id="logoImg" src="data:image/png;base64," alt="Festa com a Carol">
    <h1>Minhas medidas</h1>
    <p>Preencha seus tamanhos e marcas favoritas. No final, toque em Gerar PDF e me envie o arquivo pelo WhatsApp.</p>
  </header>

  <form id="form" novalidate>
    <fieldset>
      <legend>Sobre você</legend>
      <label class="field" for="nome">Nome e sobrenome</label>
      <input type="text" id="nome" autocomplete="name" placeholder="Ex.: Clarah Passos">
      <p class="hint" style="margin:6px 0 0">É só para eu identificar de quem são as respostas.</p>
    </fieldset>

    <fieldset>
      <legend>Roupas</legend>
      <p class="hint">Blusas, vestidos e tops</p>
      <div class="chips" data-group="roupa" data-type="radio">
        <label class="chip"><input type="radio" name="roupa" value="PP"><span>PP</span></label>
        <label class="chip"><input type="radio" name="roupa" value="P"><span>P</span></label>
        <label class="chip"><input type="radio" name="roupa" value="M"><span>M</span></label>
        <label class="chip"><input type="radio" name="roupa" value="G"><span>G</span></label>
        <label class="chip"><input type="radio" name="roupa" value="GG"><span>GG</span></label>
      </div>
      <div class="row">
        <div>
          <label class="field" for="calca">Calça e short</label>
          <select id="calca">
            <option value="">Selecione</option>
            <option>34</option><option>36</option><option>38</option><option>40</option>
            <option>42</option><option>44</option><option>46</option>
          </select>
        </div>
        <div>
          <label class="field" for="calcado">Calçados</label>
          <select id="calcado">
            <option value="">Selecione</option>
            <option>33</option><option>34</option><option>35</option><option>36</option>
            <option>37</option><option>38</option><option>39</option><option>40</option>
          </select>
        </div>
      </div>
    </fieldset>

    <fieldset>
      <legend>Joias e acessórios</legend>
      <label class="field" for="aro">Aro do anel</label>
      <select id="aro">
        <option value="">Selecione</option>
        <option>10</option><option>11</option><option>12</option><option>13</option>
        <option>14</option><option>15</option><option>16</option><option>17</option>
        <option>18</option><option>19</option><option>20</option><option>21</option>
        <option>22</option><option value="Não sei">Não sei</option>
      </select>
      <label class="field">Prefere acessórios</label>
      <div class="chips">
        <label class="chip"><input type="radio" name="metal" value="Dourados"><span>Dourados</span></label>
        <label class="chip"><input type="radio" name="metal" value="Prateados"><span>Prateados</span></label>
        <label class="chip"><input type="radio" name="metal" value="Dourados e prateados"><span>Gosto dos dois</span></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Perfumes</legend>
      <p class="hint">Que tipo de perfume você gosta? Marque quantos quiser</p>
      <div class="chips">
        <label class="chip"><input type="checkbox" name="perfume" value="Doce"><span>Doce</span></label>
        <label class="chip"><input type="checkbox" name="perfume" value="Floral"><span>Floral</span></label>
        <label class="chip"><input type="checkbox" name="perfume" value="Frutado"><span>Frutado</span></label>
        <label class="chip"><input type="checkbox" name="perfume" value="Cítrico"><span>Cítrico</span></label>
        <label class="chip"><input type="checkbox" name="perfume" value="Fresco"><span>Fresco</span></label>
        <label class="chip"><input type="checkbox" name="perfume" value="Amadeirado"><span>Amadeirado</span></label>
        <label class="chip"><input type="checkbox" name="perfume" value="Suave"><span>Suave</span></label>
        <label class="chip"><input type="checkbox" name="perfume" value="Marcante"><span>Marcante</span></label>
      </div>
      <label class="field" for="perfumesFav">Perfumes ou body splashes que você ama</label>
      <input type="text" id="perfumesFav" placeholder="Ex.: Lily, Egeo Dolce, Victoria's Secret">
    </fieldset>

    <fieldset>
      <legend>Maquiagem</legend>
      <label class="field">Gosta de ganhar maquiagem?</label>
      <div class="chips">
        <label class="chip"><input type="radio" name="make" value="Sim"><span>Sim</span></label>
        <label class="chip"><input type="radio" name="make" value="Não"><span>Não</span></label>
      </div>
    </fieldset>

    <fieldset>
      <legend>Lojas favoritas</legend>
      <p class="hint">Marque quantas quiser</p>
      <div class="chips" id="lojas"></div>
      <label class="field" for="outras">Outras lojas ou marcas</label>
      <input type="text" id="outras" placeholder="Ex.: Boticário, Shein, Renner">
    </fieldset>

    <fieldset>
      <legend>Recado para os convidados</legend>
      <p class="hint">Opcional</p>
      <textarea id="recado" placeholder="Ex.: Sua presença já é o maior presente!"></textarea>
    </fieldset>

    <div class="actions">
      <button type="button" class="btn-main" id="gerar">Gerar PDF</button>
      <button type="button" class="btn-share" id="enviar">Enviar no WhatsApp</button>
      <p class="msg" id="msg" role="status" aria-live="polite"></p>
    </div>
  </form>

  <div class="rainbow" aria-hidden="true"><i style="background:#FF6AA5"></i><i style="background:#C4B1F4"></i><i style="background:#A9DDF5"></i><i style="background:#AEE3C8"></i><i style="background:#FFA98F"></i></div>
  <footer>byfestacomacarol.com.br</footer>
</div>

<script>
  const LOGO = document.getElementById("logoImg").src;
  const LOJAS = ["Chilli Beans","Cotton On","Farm","Garage","Granado","H&M","Hering","L'Occitane",
    "Morana","Natura","NV","Océane","Plaka Acessórios","Riachuelo","Santa Lolla","Sephora",
    "Schutz","Stanley","Track & Field","Vivara","Youcom","Zara"];

  const lojasBox = document.getElementById("lojas");
  LOJAS.forEach(l => {
    const lab = document.createElement("label");
    lab.className = "chip";
    lab.innerHTML = '<input type="checkbox" name="loja"><span></span>';
    lab.querySelector("input").value = l;
    lab.querySelector("span").textContent = l;
    lojasBox.appendChild(lab);
  });

  const $ = id => document.getElementById(id);
  const radio = n => (document.querySelector(`input[name="${n}"]:checked`) || {}).value || "";
  const msg = $("msg");
  let pdfFile = null;

  function coletar(){
    const lojas = [...document.querySelectorAll('input[name="loja"]:checked')].map(i => i.value);
    const outras = $("outras").value.trim();
    if (outras) lojas.push(...outras.split(/[,;\n]+/).map(s => s.trim()).filter(Boolean));
    return {
      nome: $("nome").value.trim(),
      roupa: radio("roupa"),
      calca: $("calca").value,
      calcado: $("calcado").value,
      aro: $("aro").value,
      metal: radio("metal"),
      perfumes: [...document.querySelectorAll('input[name="perfume"]:checked')].map(i => i.value).join(", "),
      perfumesFav: $("perfumesFav").value.trim(),
      make: radio("make"),
      lojas,
      recado: $("recado").value.trim()
    };
  }

  function gerarPDF(d){
    const { jsPDF } = window.jspdf;
    const doc = new jsPDF({ unit:"mm", format:"a4" });
    const W = 210, M = 24;
    const pink = [224,80,138], ink = [74,59,92], muted = [138,127,152];
    const cores = [[255,106,165],[196,177,244],[169,221,245],[174,227,200],[255,169,143]];
    let y = 0, sec = 0;

    const fundo = () => {
      doc.setFillColor(249,247,243); doc.rect(0,0,W,297,"F");
      const bw = W/cores.length;
      cores.forEach((c,i) => { doc.setFillColor(...c); doc.rect(i*bw,0,bw+0.2,4,"F"); doc.rect(i*bw,293,bw+0.2,4,"F"); });
    };
    fundo();

    doc.addImage(LOGO, "PNG", W/2-30, 14, 60, 30.9);
    y = 56;
    doc.setFont("helvetica","bold"); doc.setFontSize(26); doc.setTextColor(...pink);
    doc.text("Minhas medidas", W/2, y, { align:"center" });
    if (d.nome){
      y += 9;
      doc.setFont("helvetica","normal"); doc.setFontSize(13); doc.setTextColor(...ink);
      doc.text(d.nome, W/2, y, { align:"center" });
    }
    y += 13;

    const secao = t => {
      if (y > 268){ doc.addPage(); fundo(); y = 24; }
      const c = cores[sec++ % cores.length];
      doc.setFillColor(...c); doc.circle(M+2.2, y-1.6, 2.2, "F");
      doc.setFont("helvetica","bold"); doc.setFontSize(15); doc.setTextColor(...ink);
      doc.text(t, M+7, y); y += 3.5;
      doc.setDrawColor(...c); doc.setLineWidth(0.6); doc.setLineDashPattern([1.5,1.5],0);
      doc.line(M, y, W-M, y); doc.setLineDashPattern([],0); y += 7;
    };
    const item = (rot, val) => {
      doc.setFont("helvetica","normal"); doc.setFontSize(11); doc.setTextColor(...muted);
      doc.text(rot, M, y);
      doc.setFont("helvetica","bold"); doc.setTextColor(...ink);
      const v = val || "—";
      if (doc.getTextWidth(v) > (W - 2*M) - doc.getTextWidth(rot) - 10){
        y += 5.5;
        const ls = doc.splitTextToSize(v, W - 2*M);
        doc.text(ls, M, y); y += (ls.length - 1) * 5.5 + 7;
      } else {
        doc.text(v, W-M, y, { align:"right" }); y += 7;
      }
    };
    const bloco = (rot, val) => { if (val) item(rot, val); };

    secao("Roupas e calçados");
    item("Blusas, vestidos e tops", d.roupa);
    item("Calça e short", d.calca);
    item("Calçados", d.calcado);
    y += 3;

    secao("Joias e acessórios");
    item("Aro do anel", d.aro);
    item("Acessórios", d.metal);
    y += 3;

    secao("Perfumes");
    item("Tipo que gosta", d.perfumes);
    bloco("Favoritos", d.perfumesFav);
    y += 3;

    secao("Maquiagem");
    item("Gosta de ganhar maquiagem", d.make);
    y += 3;

    secao("Lojas favoritas");
    doc.setFont("helvetica","normal"); doc.setFontSize(11.5); doc.setTextColor(...ink);
    const txtLojas = d.lojas.length ? d.lojas.join("   •   ") : "—";
    const linhas = doc.splitTextToSize(txtLojas, W - 2*M);
    doc.text(linhas, M, y); y += linhas.length * 5.5 + 5;

    if (d.recado){
      secao("Recado para os convidados");
      doc.setFont("helvetica","italic"); doc.setFontSize(12.5); doc.setTextColor(...ink);
      const r = doc.splitTextToSize("“" + d.recado + "”", W - 2*M);
      doc.text(r, M, y); y += r.length * 6 + 4;
    }

    doc.setFont("helvetica","normal"); doc.setFontSize(9); doc.setTextColor(...muted);
    doc.text("byfestacomacarol.com.br", W/2, 286, { align:"center" });
    return doc;
  }

  $("gerar").addEventListener("click", () => {
    msg.className = "msg"; msg.textContent = "";
    if (!window.jspdf){
      msg.className = "msg error";
      msg.textContent = "Não foi possível carregar o gerador de PDF. Verifique a internet e recarregue a página.";
      return;
    }
    const d = coletar();
    if (!d.nome){
      msg.className = "msg error";
      msg.textContent = "Coloque seu nome e sobrenome para eu saber de quem são as respostas.";
      $("nome").focus();
      return;
    }
    if (!d.roupa && !d.calcado && !d.aro && !d.lojas.length){
      msg.className = "msg error";
      msg.textContent = "Preencha pelo menos um tamanho ou uma loja antes de gerar o PDF.";
      return;
    }
    const doc = gerarPDF(d);
    const slug = (d.nome || "debutante").normalize("NFD").replace(/[\u0300-\u036f]/g,"")
      .toLowerCase().replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");
    const nomeArq = `medidas-${slug}.pdf`;
    const blob = doc.output("blob");
    pdfFile = new File([blob], nomeArq, { type:"application/pdf" });
    doc.save(nomeArq);

    if (navigator.canShare && navigator.canShare({ files:[pdfFile] })){
      $("enviar").style.display = "block";
      msg.textContent = "PDF baixado! Toque em Enviar no WhatsApp para mandar direto.";
    } else {
      msg.textContent = "PDF baixado! Agora é só anexar o arquivo na conversa do WhatsApp.";
    }
  });

  $("enviar").addEventListener("click", async () => {
    if (!pdfFile) return;
    try {
      await navigator.share({ files:[pdfFile], title:"Minhas medidas" });
    } catch (e) {
      if (e.name !== "AbortError"){
        msg.className = "msg error";
        msg.textContent = "Não deu para compartilhar daqui. Anexe o PDF baixado direto no WhatsApp.";
      }
    }
  });
</script>
</body>
</html>
